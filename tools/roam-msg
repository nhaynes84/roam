#!/usr/bin/env python3
"""roam-msg -- tell the wearer something. **Everything goes through the hub.**

Usage: roam-msg [--pane N] "your message here"

Every agent and session on this box is told to push its status to ROAM. This
is the tool that does it, and all it does is say what happened; the hub decides
whether it is worth interrupting him for, and the bridge is the only thing that
touches the phone.

★ Why it works this way. `roam-msg` used to shell out to
`adb ... cmd notification post`, straight at the device. The hub already owned
the rule that matters -- **reply where the last message came from**: a prompt
typed in tmux means he is at the keyboard, so its outcome must not buzz -- and
`roam-msg` ignored all of it. So every agent's status line rang his phone while
he sat two feet from the screen it was about. Owner: *"what's the point of a
'hub' if all traffic doesn't go through it..."*

⚠️ The fix is not to teach this script the rule. A short-lived patch did that
(it called `GET /presence` and skipped when covered) and it was worse: a second
copy of the policy, in a client, free to drift from the hub's. There is one
copy, it lives in the hub, and this program holds no opinion whatsoever.

★ **If the hub is not running the message goes into the ledger, never to the
device and never to a file.** The hub is a *local* service and everything that
talks to it -- Claude Code, the agents, this script, the bridge -- is this one
box (owner: *"if talos is down, how the fuck am i talking to you, lol"*). So
"unreachable" only ever means the process is stopped, and then the bridge is
stopped too and nothing could deliver anyway; an adb push at that moment would
be the only thing still arriving on his wrist, which reads as a healthy
pipeline while every real outcome is stalled.

`hub.sqlite` is on the same disk and is open in WAL mode, so the row goes
straight into the ledger flagged `pending`, and the hub adopts and pushes it on
its first poll. One store of record, no dead-letter file (owner: *"you have a
DB for messages, why would we use a DL file"*), and the message actually
arrives -- late -- instead of being lost.

`tools/roam-push` is the deliberate, marked exception: it is the bridge's
transport, it holds no policy, and nothing else calls it.

Env:
  ROAM_HUB             hub base URL. Default: the tailnet address of talos.
  ROAM_HUB_TOKEN_FILE  bearer token file. Default: hub/hub-token.txt.
  ROAM_HUB_TIMEOUT     seconds to wait on the hub. Default 4.
"""

from __future__ import annotations

import json
import os
import socket
import sqlite3
import sys
import urllib.error
import urllib.request
from pathlib import Path

HUB_DIR = Path.home() / "Projects/roam/roam-touch/hub"
DEFAULT_HUB = "http://100.67.237.109:8787"
DEFAULT_TOKEN_FILE = HUB_DIR / "hub-token.txt"
DEFAULT_TIMEOUT_S = 4.0

HOSTNAME = socket.gethostname().split(".")[0]

#: The ledger itself -- the same file the hub writes, not a copy of it.
LEDGER = HUB_DIR / "hub.sqlite"

#: ⚠️ The rail on the offline path. Nothing on this box grows forever, and an
#: agent in a loop with the hub stopped must not be able to write until the
#: disk fills. Past this, messages are dropped and said to be dropped.
MAX_PENDING = 200


def read_token(env) -> str:
    path = Path(env.get("ROAM_HUB_TOKEN_FILE") or DEFAULT_TOKEN_FILE)
    return path.read_text(encoding="utf-8").strip()


def resolve_pane(explicit: str | None, env) -> str | None:
    """Which channel this message is about.

    `$TMUX_PANE` is the whole of the attribution story: it is set for every
    shell inside tmux, and it is inherited by agents and their subagents, so a
    message from an agent working in pane %3 says so without anyone wiring it
    up. That is what lets the hub apply "he typed the prompt in that pane" to a
    status line -- without it, no rule can fire and everything buzzes.

    ⚠️ No pane means **no pane** -- return None and let the hub file it on the
    host channel. Borrowing some other pane's id would attach the message to a
    conversation that did not send it, and it would then inherit that
    conversation's coverage: silence for a message nobody was watching for.
    """
    if explicit:
        pane = explicit.strip()
        return pane if pane.startswith("%") else "%" + pane
    pane = (env.get("TMUX_PANE") or "").strip()
    return pane or None


def open_ledger():
    """The hub's own `Store`, opened on the hub's own database.

    Imported rather than reimplemented: the summary, the body rail and the
    schema are the hub's, and a client with its own copy of them is a client
    whose rows drift from everyone else's.
    """
    if str(HUB_DIR) not in sys.path:
        sys.path.insert(0, str(HUB_DIR))
    from store import Store

    return Store(LEDGER)


def record_offline(text: str, pane: str | None, why: str) -> tuple[bool, str]:
    """Write the message into the ledger, flagged as never having been pushed.

    Returns `(recorded, pane_id_or_reason)`. Never raises: a status line must
    not be able to take down the agent that sent it.

    ⚠️ Two writers on one SQLite file is fine in WAL and still has to be
    handled rather than assumed. sqlite3 waits out a busy lock for 5 s and then
    raises; that is a drop, said out loud, not a hang.
    """
    try:
        store = open_ledger()
        from store import EventKind, HOST_CHANNEL_ID
    except sqlite3.OperationalError as exc:
        return False, f"the ledger is locked ({exc})"
    except Exception as exc:  # a missing hub dir, a schema too new to open
        return False, f"cannot open the ledger at {LEDGER} ({exc})"
    try:
        waiting = store.pending_count()
        if waiting >= MAX_PENDING:
            return False, f"{waiting} messages already waiting for the hub"
        pane_id = pane or HOST_CHANNEL_ID
        if store.get_channel(pane_id) is None:
            store.remember_channel(pane_id, pane_id, HOSTNAME)
        store.append(
            pane_id,
            EventKind.NOTICE,
            text,
            {
                "source": "roam-msg",
                "host": HOSTNAME,
                "offline": True,
                "offline_reason": why,
            },
            pending=True,
        )
        return True, pane_id
    except sqlite3.OperationalError as exc:
        return False, f"the ledger is locked ({exc})"
    finally:
        try:
            store.close()
        except Exception:
            pass


def post_notice(hub: str, token: str, payload: dict, timeout: float) -> dict:
    request = urllib.request.Request(
        hub.rstrip("/") + "/notify",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {token}",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def main(argv=None, env=None, stdout=None, stderr=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    env = os.environ if env is None else env
    out = stdout or sys.stdout
    err = stderr or sys.stderr

    pane_arg: str | None = None
    while argv and argv[0].startswith("--"):
        flag = argv.pop(0)
        if flag == "--pane" and argv:
            pane_arg = argv.pop(0)
        elif flag == "--force":
            # Was "skip the presence check" during the hour this script decided
            # for itself. It decides nothing now, so it cannot skip anything.
            print(
                "roam-msg: --force no longer means anything; the hub decides",
                file=err,
            )
        elif flag == "--":
            break
        else:
            print(f"roam-msg: unknown option {flag}", file=err)
            return 1

    text = " ".join(argv).strip()
    if not text:
        print("roam-msg: nothing to send", file=err)
        return 1

    pane = resolve_pane(pane_arg, env)
    payload: dict = {"text": text, "source": "roam-msg", "meta": {"host": HOSTNAME}}
    if pane:
        payload["pane"] = pane

    hub = env.get("ROAM_HUB") or DEFAULT_HUB
    try:
        timeout = float(env.get("ROAM_HUB_TIMEOUT") or DEFAULT_TIMEOUT_S)
    except ValueError:
        timeout = DEFAULT_TIMEOUT_S

    try:
        token = read_token(env)
    except OSError as exc:
        return offline(text, pane, f"no hub token ({exc})", out, err)

    try:
        answer = post_notice(hub, token, payload, timeout)
    except urllib.error.HTTPError as exc:
        return offline(text, pane, f"hub answered {exc.code}", out, err)
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError) as exc:
        return offline(text, pane, f"no hub at {hub} ({exc})", out, err)

    event = answer.get("event") or {}
    where = event.get("pane_id") or "?"
    if answer.get("push"):
        print(f"roam-msg: {where} — push queued ({answer.get('reason', '')})", file=out)
    else:
        print(f"roam-msg: {where} — no push ({answer.get('reason', '')})", file=out)
    waiting = answer.get("pending") or 0
    if waiting:
        # Said on the way past, because this is the moment he is listening.
        print(
            f"roam-msg: ⚠️ {waiting} pending message(s) went around the hub "
            f"while it was down; it will push them on its next poll.",
            file=out,
        )
    return 0


def offline(text: str, pane: str | None, why: str, out, err) -> int:
    """The hub process is not running. Put it in the ledger and say so."""
    recorded, detail = record_offline(text, pane, why)
    if recorded:
        print(f"roam-msg: hub down ({why})", file=err)
        print(
            f"roam-msg: {detail} — recorded in the ledger, pending; "
            f"the hub pushes it when it is back",
            file=out,
        )
        return 0
    print(
        f"roam-msg: DROPPED — hub down ({why}) and not recorded: {detail}",
        file=err,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
