#!/bin/bash
# roam-msg — push a message to ROAM Touch over the network.
#
# BLE IS RETIRED. This talks to the phone (ROAM Touch) over Tailscale, so it
# works from any machine on the tailnet, from anywhere, with no pairing, no
# proximity and no CoreBluetooth permission. The old chunked BLE path (127-byte
# buffer, roam-send) is gone -- see git history if you ever need it back.
#
# Usage: roam-msg [--pane N] "your message here"
#   --pane N   tag the notification per tmux pane so panes don't overwrite
#              each other on the phone.
#
# Env:
#   ROAM_DEV   adb target. Default is the Pixel on the tailnet.
#   ROAM_TITLE notification title. Default "Claude / <hostname>".

set -uo pipefail   # NOT -e: an unreachable phone must not kill the caller

ROAM_DEV="${ROAM_DEV:-100.95.196.87:5555}"
ROAM_TITLE="${ROAM_TITLE:-Claude / $(hostname -s)}"
TAG="roam"

if [ "${1:-}" = "--pane" ]; then
    shift
    TAG="pane${1:-0}"
    shift
fi

msg="$*"
[ -z "$msg" ] && { echo "roam-msg: nothing to send" >&2; exit 1; }

# Single-quote for the device-side shell: ' -> '\''
q() { printf "%s" "$1" | sed "s/'/'\\\\''/g"; }

# Reconnect if the transport dropped (adb tcpip does not survive a phone reboot).
# ⚠️ Bounded: a sleeping/absent phone makes `adb connect` sit for ~75 s, which
# stalls every caller behind it. Fail fast instead -- a missed status message is
# nothing, a wedged queue is a real problem.
if ! adb devices | grep -q "^${ROAM_DEV}[[:space:]]*device$"; then
    _timeout() { perl -e 'alarm shift; exec @ARGV' "$@" 2>/dev/null; }
    _timeout 5 adb connect "$ROAM_DEV" >/dev/null 2>&1
fi

if ! adb -s "$ROAM_DEV" shell \
        "cmd notification post -S bigtext -t '$(q "$ROAM_TITLE")' '$(q "$TAG")' '$(q "$msg")'" \
        >/dev/null 2>&1; then
    echo "roam-msg: FAILED — ROAM Touch unreachable at $ROAM_DEV" >&2
    exit 1
fi

# Confirm delivery. Silence reads as success *or* as a silent no-op, and a
# caller cannot tell those apart -- so say so explicitly. roam-notify still
# suppresses this by redirecting.
echo "roam-msg: delivered to $ROAM_DEV [$TAG] (${#msg} chars)"
