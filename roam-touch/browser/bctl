"""bctl -- drive the roam-browser daemon from the shell (and thus from the agent).

    bctl goto example.com
    bctl snapshot                 # visible clickable/typeable things + selectors
    bctl click "#submit"
    bctl fill "input[name=q]" "hello world"
    bctl press Enter
    bctl text                     # readable text of the page (or: bctl text main)
    bctl screenshot [path] [--full]   # PNG the agent can Read
    bctl eval "document.title"
    bctl wait "#results"          # or: bctl wait 2000   (ms)
    bctl where | ping | stop

The daemon is auto-started on first use; the browser page persists between calls,
so a login or a mid-form state survives across commands.
"""

import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
PORT = 8791
BASE = f"http://127.0.0.1:{PORT}"


def _ping() -> bool:
    try:
        with urllib.request.urlopen(BASE + "/ping", timeout=3) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError):
        return False


def _ensure_daemon() -> None:
    if _ping():
        return
    subprocess.Popen(
        [str(HERE / ".venv/bin/python"), str(HERE / "driver.py")],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(60):  # Chromium launch takes a few seconds
        if _ping():
            return
        time.sleep(0.5)
    sys.exit("roam-browser daemon did not come up")


def _post(body: dict) -> dict:
    req = urllib.request.Request(
        BASE + "/cmd",
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read())


def build(argv: list[str]) -> dict:
    action, rest = argv[0], argv[1:]
    a = action
    if a in ("where", "snapshot", "back", "forward"):
        return {"action": a}
    if a == "goto":
        return {"action": "goto", "url": rest[0]}
    if a == "click":
        return {"action": "click", "selector": rest[0]}
    if a in ("fill", "type"):
        return {"action": a, "selector": rest[0], "text": rest[1] if len(rest) > 1 else ""}
    if a == "press":
        return ({"action": "press", "selector": rest[0], "key": rest[1]}
                if len(rest) >= 2 else {"action": "press", "key": rest[0] if rest else "Enter"})
    if a == "select":
        return {"action": "select", "selector": rest[0], "value": rest[1]}
    if a == "wait":
        if rest and rest[0].isdigit():
            return {"action": "wait", "ms": int(rest[0])}
        return {"action": "wait", "selector": rest[0] if rest else ""}
    if a == "text":
        return {"action": "text", "selector": rest[0] if rest else "body"}
    if a == "html":
        return {"action": "html", "selector": rest[0] if rest else ""}
    if a == "eval":
        return {"action": "eval", "js": rest[0]}
    if a == "screenshot":
        full = "--full" in rest
        rest = [r for r in rest if r != "--full"]
        return {"action": "screenshot", "path": rest[0] if rest else "", "full": full}
    sys.exit(f"unknown command: {a}")


def main() -> int:
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd = sys.argv[1]
    if cmd == "ping":
        print("up" if _ping() else "down")
        return 0
    if cmd in ("stop", "shutdown"):
        if _ping():
            try:
                _post({"action": "shutdown"})
            except Exception:
                pass
        print("stopped")
        return 0
    if cmd == "start":
        _ensure_daemon()
        print(json.dumps(_post({"action": "where"}), indent=2))
        return 0

    _ensure_daemon()
    result = _post(build(sys.argv[1:]))
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0 if result.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
