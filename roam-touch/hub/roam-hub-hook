#!/Users/talos/Projects/roam/roam-touch/hub/.venv/bin/python
"""roam-hub-hook -- report a receipt or an outcome to the ROAM Touch hub.

Usage:  roam-hub-hook receipt|outcome|note [body]

Meant to run as a Claude Code hook: `UserPromptSubmit` -> receipt,
`Stop` -> outcome. Claude Code passes the hook payload as JSON on stdin
(`session_id`, `transcript_path`, `cwd`, and `prompt` for UserPromptSubmit).

* **outcome** carries the assistant's actual answer, pulled out of
  `transcript_path`. A notification that only says "finished" would be
  useless -- the point of the device is not walking back to the computer to
  find out what was said.
* **receipt** carries the prompt that was submitted, so a channel shows real
  activity even when the wearer typed at the desk.

The event is tagged with `$TMUX_PANE`, so it lands on exactly the channel that
was prompted -- pane ids are stable and never reused, unlike session:window.pane.

It NEVER fails loudly: a hook that can break the session it reports on is worse
than a missing notification. No tmux, no token, no hub, no transcript -> exit 0.

Env: ROAM_HUB_URL (default the tailnet address), ROAM_HUB_TOKEN_FILE.
"""

from __future__ import annotations

import json
import os
import socket
import sys
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

DEFAULT_URL = "http://100.67.237.109:8787"
TIMEOUT_S = 3.0
#: How long the transcript fallback may wait for this turn's answer to be
#: flushed. The hook's own timeout is 15 s; this plus the POST stays well
#: inside it. A missed outcome is acceptable, a hung session is not.
DEFAULT_SETTLE_MS = 2000.0


def read_hook_payload() -> dict:
    """Claude Code's JSON on stdin. A terminal or junk means "nothing"."""
    if sys.stdin is None or sys.stdin.isatty():
        return {}
    try:
        raw = sys.stdin.read()
    except (OSError, ValueError):
        return {}
    dump = os.environ.get("ROAM_HUB_HOOK_DUMP")
    if dump:
        # Diagnostics: capture exactly what Claude Code sends. The hook payload
        # is the only authority on its own schema -- guessing it is what put
        # the wrong answer on the user's arm once already.
        try:
            with open(dump, "a", encoding="utf-8") as fh:
                fh.write(raw.rstrip("\n") + "\n")
        except OSError:
            pass
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def outcome_body(payload: dict, transcript_path: str) -> tuple[str, dict]:
    """The answer this Stop is about, plus what to record about how we got it.

    **The hook payload is the authority.** Claude Code 2.1.228 hands a `Stop`
    hook `last_assistant_message` -- the finished answer, in memory, before
    anything is flushed anywhere (verified by capturing a real payload from a
    live turn, not from the docs). Using it removes the disk race entirely.

    The transcript path stays as a fallback for any version or event shape that
    does not provide it, and that fallback *waits* for the record belonging to
    this turn rather than trusting whatever is on disk at the instant the hook
    fires -- see `transcript.settled_assistant_text`.

    Diagnostics (both exist so the old, racy behaviour can be reproduced on a
    live turn rather than argued about):
      ROAM_HUB_ANSWER_SOURCE=transcript  ignore the payload, read the file
      ROAM_HUB_SETTLE_MS=0               do not wait for the flush
    """
    prefer = os.environ.get("ROAM_HUB_ANSWER_SOURCE", "payload")
    if prefer != "transcript":
        message = payload.get("last_assistant_message")
        if isinstance(message, str) and message.strip():
            return message.strip(), {"answer_source": "hook_payload"}
    if not transcript_path:
        return "", {"answer_source": "none"}
    try:
        settle_ms = float(os.environ.get("ROAM_HUB_SETTLE_MS", DEFAULT_SETTLE_MS))
    except ValueError:
        settle_ms = DEFAULT_SETTLE_MS
    try:
        from transcript import settled_assistant_text

        body, settled = settled_assistant_text(
            transcript_path, timeout=max(0.0, settle_ms) / 1000.0
        )
    except Exception:
        return "", {"answer_source": "transcript", "transcript_settled": False}
    # settled=False means the answer never landed inside the window: the body
    # may be an earlier block of the same turn. Say so, so it is detectable.
    return body, {"answer_source": "transcript", "transcript_settled": settled}


def main() -> int:
    kind = sys.argv[1] if len(sys.argv) > 1 else ""
    override = sys.argv[2] if len(sys.argv) > 2 else ""
    pane = os.environ.get("TMUX_PANE", "")
    if not kind or not pane:
        return 0  # nothing to report, or not inside tmux

    token_file = Path(
        os.environ.get("ROAM_HUB_TOKEN_FILE", HERE / "hub-token.txt")
    )
    try:
        token = token_file.read_text(encoding="utf-8").strip()
    except OSError:
        return 0
    if not token:
        return 0

    payload = read_hook_payload()
    transcript_path = payload.get("transcript_path") or ""
    body = override
    meta = {
        "source": "claude-hook",
        "host": socket.gethostname().split(".")[0],
        "session_id": payload.get("session_id", ""),
        "prompt_id": payload.get("prompt_id", ""),
        "transcript_path": transcript_path,
    }

    if not body and kind == "outcome":
        body, extra = outcome_body(payload, transcript_path)
        meta.update(extra)
    if not body and kind == "receipt":
        body = str(payload.get("prompt") or "")

    event = {"pane": pane, "kind": kind, "body": body, "meta": meta}
    request = urllib.request.Request(
        os.environ.get("ROAM_HUB_URL", DEFAULT_URL).rstrip("/") + "/events",
        data=json.dumps(event).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        urllib.request.urlopen(request, timeout=TIMEOUT_S).read()
    except (urllib.error.URLError, OSError, ValueError):
        # The hub being down must never disturb the session -- but the answer
        # must not be lost either. Hub RESTARTS are routine (every deploy), and
        # a Stop that fired inside one silently ate the outcome: the channel
        # sat "working" -> "quiet" until someone read the raw pane. Same
        # fallback as roam-msg: write the row straight into the ledger,
        # pending=1; the hub adopts and pushes it on its next poll, a few
        # seconds late instead of never.
        try:
            sys.path.insert(0, str(HERE))
            from store import Store, EventKind

            db_path = Path(os.environ.get("ROAM_HUB_DB_PATH", HERE / "hub.sqlite"))
            store = Store(db_path)
            if store.get_channel(pane) is None:
                store.remember_channel(pane, pane, socket.gethostname().split(".")[0])
            store.append(
                pane,
                EventKind(kind),
                body,
                {**meta, "offline": True},
                pending=True,
            )
            store.close()
        except Exception:
            pass  # both paths down: nothing more a hook may do
    return 0


if __name__ == "__main__":
    sys.exit(main())
