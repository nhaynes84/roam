#!/usr/bin/env python3
"""
Memory search against the harness index.

  semantic (default) — Ollama nomic-embed-text, for "what did we decide about X"
  --exact            — FTS5 literal match, for "when did `wifi_sleep_policy` appear"

Sources: projects, claude, physics, rongorongo, jeanne, memory (frozen),
         ledger (ROAM hub events), sessions (Claude transcripts).

Usage: memsearch "your query" [--top N] [--source S] [--exact]
"""
import os
import sys
import json
import sqlite3
import urllib.request
import math
import argparse

DB_PATH = os.path.expanduser("~/.claude/memory/index.sqlite")
OLLAMA_URL = "http://localhost:11434/api/embeddings"
EMBED_MODEL = "nomic-embed-text"

def embed(text):
    payload = json.dumps({"model": EMBED_MODEL, "prompt": text}).encode()
    req = urllib.request.Request(OLLAMA_URL, data=payload, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read())["embedding"]

def cosine_similarity(a, b):
    dot = sum(x * y for x, y in zip(a, b))
    mag_a = math.sqrt(sum(x * x for x in a))
    mag_b = math.sqrt(sum(x * x for x in b))
    if mag_a == 0 or mag_b == 0:
        return 0.0
    return dot / (mag_a * mag_b)

SOURCE_CHOICES = ["projects", "claude", "physics", "rongorongo", "jeanne",
                  "memory", "ledger", "sessions"]


def search_exact(query, top_n=5, source_filter=None):
    """Literal FTS5 match. No model, no embedding, and the right tool for a
    string you already know -- an identifier, a filename, an error message."""
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    sql = ("SELECT id, path, source, text, bm25(chunks_fts_v2) AS rank "
           "FROM chunks_fts_v2 WHERE chunks_fts_v2 MATCH ?")
    params = [query]
    if source_filter:
        sql += " AND source = ?"
        params.append(source_filter)
    sql += " ORDER BY rank LIMIT ?"
    params.append(top_n)
    try:
        rows = con.execute(sql, params).fetchall()
    except sqlite3.OperationalError as e:
        print(f"exact search unavailable: {e}", file=sys.stderr)
        return []
    finally:
        con.close()
    # bm25 is "lower is better"; present it the same way as a similarity score.
    return [(-row["rank"], dict(row)) for row in rows]


def search(query, top_n=5, source_filter=None):
    query_vec = embed(query)

    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row

    sql = "SELECT id, path, source, start_line, end_line, text, embedding FROM chunks"
    params = []
    if source_filter:
        sql += " WHERE source = ?"
        params.append(source_filter)

    rows = con.execute(sql, params).fetchall()
    con.close()

    scored = []
    for row in rows:
        vec = json.loads(row["embedding"])
        score = cosine_similarity(query_vec, vec)
        scored.append((score, dict(row)))

    scored.sort(key=lambda x: x[0], reverse=True)
    return scored[:top_n]

def main():
    parser = argparse.ArgumentParser(description="Semantic memory search")
    parser.add_argument("query", help="Search query")
    parser.add_argument("--top", type=int, default=5, help="Number of results (default: 5)")
    parser.add_argument("--source", choices=SOURCE_CHOICES, help="Filter by source")
    parser.add_argument("--exact", action="store_true",
                        help="Literal FTS5 match instead of semantic search")
    args = parser.parse_args()

    if args.exact:
        results = search_exact(args.query, top_n=args.top, source_filter=args.source)
    else:
        results = search(args.query, top_n=args.top, source_filter=args.source)

    for score, chunk in results:
        where = chunk.get("start_line")
        span = f" (lines {chunk['start_line']}-{chunk['end_line']})" if where is not None else ""
        print(f"\n--- [{score:.3f}] {chunk['path']}{span} source: {chunk['source']} ---")
        print(chunk["text"].strip())

if __name__ == "__main__":
    main()
