<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Black, no action bar. Compose paints everything below the status bar; the window
      background matters only for the frame or two before the first composition, and a
      white flash on a wrist at night is exactly the kind of detail that gets a device
      taken off and left on a desk.
    -->
    <style name="Theme.Roam" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF06070A</item>
        <item name="android:navigationBarColor">#FF14171D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
