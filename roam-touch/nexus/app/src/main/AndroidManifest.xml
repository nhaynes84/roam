<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Tailscale is the only network this app uses, and the hub is plain HTTP on a
      WireGuard-encrypted tailnet address (see HubConfig). INTERNET is the whole
      network surface; there is no cleartext exception needed on API 29 because
      usesCleartextTraffic defaults to true below targetSdk 28+... it does not, so it
      is declared explicitly rather than left to a default nobody can recall.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The panel has to come back after a reboot without anyone tapping anything. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      ⚠️ Push to talk, and nothing else. The mic is opened by MicRecorder, which is
      called from exactly one place — a press on the PTT control — and is closed on
      release. There is no wake word, no VAD and no background listening; see
      com.roam.touch.channels.stt.Ptt and MicPolicyTest, which fail if that changes.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      ⚠️⚠️ Push to talk records from a BLUETOOTH HEADSET, not from this handset. Its own
      analog capture is dead at the HAL (measured: every source, rate and buffer size
      fails pcm_prepare and returns zero-filled buffers), and a headset mic is a separate
      microphone, codec and link on the far side of that. MODIFY_AUDIO_SETTINGS is what
      lets BluetoothHeadsetLink set MODE_IN_COMMUNICATION and bring SCO up; BLUETOOTH is
      what lets it see whether a headset is connected at all. Without these the app can
      only open a microphone that is known to deliver nothing.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_roam"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Roam">

        <!--
          singleTop is load-bearing, not cosmetic: a device-owner package cannot be
          force-stopped, so this activity stays resident and `am start` would otherwise
          just re-front the task and drop the clear_device_owner extra. See MainActivity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Roam"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                  HOME + DEFAULT make Nexus eligible as a home screen. Which one Home
                  actually lands on is then pinned by addPersistentPreferredActivity in
                  MainActivity (device-owner only), so no launcher-picker dialog appears.
                  The stock Pixel launcher stays installed as the fallback.
                -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Managed-provisioning entry points (API 29+). Not used by the adb
          `dpm set-device-owner` route, but present so QR / NFC provisioning
          works later without a manifest change.
        -->
        <activity
            android:name=".ProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The device-admin component. `dpm set-device-owner` names exactly this:
              com.roam.touch/.NexusDeviceAdminReceiver
          BIND_DEVICE_ADMIN is mandatory — without it the system refuses the
          component outright.
        -->
        <receiver
            android:name=".NexusDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
          Holds the hub socket and the voice while the panel is not on screen. Without
          it the two things the wearer actually asked for — hear the outcome with the
          screen off, and never mistake a dead link for a quiet one — both die at the
          first doze window.
        -->
        <service
            android:name=".channels.HubService"
            android:exported="false" />

        <receiver
            android:name=".channels.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
