<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Stream: this device can be the open mic, or hold PTT to talk back. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Stream"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stream"
        android:usesCleartextTraffic="true">
        <!-- cleartext: the hub is plain HTTP and WireGuard does the encrypting.
             Same rationale as the Mac client's NSAllowsArbitraryLoads. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Stream"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- ⚠️ LAUNCHER only. Deliberately NOT HOME/DEFAULT: :app is the
                     wrist launcher, this is an ordinary app on an ordinary phone. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- An open mic must be a foreground service with a permanent notification.
             Android requires it, and it is the right behaviour anyway: a live
             microphone the owner cannot see is the failure mode worth designing out. -->
        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
