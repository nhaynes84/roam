<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks and parallaxes these two layers, so the
     graph lives in the foreground inside the safe zone and the ground is its own
     full-bleed layer. A single flat PNG gets cropped to a circle on most launchers
     and loses the outer nodes, which are the half of the mark that means anything. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
